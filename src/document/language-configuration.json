{
	"folding": {
		"offSide": true
	},
	"autoClosingPairs": [
		{ "open": "\"", "close": "\"", "notIn": ["string", "comment"] },
		{ "open": "'", "close": "'", "notIn": ["string", "comment"] },
		{ "open": "`", "close": "`", "notIn": ["string", "comment"] },
		{ "open": "(", "close": ")" },
		{ "open": "[", "close": "]" },
		{ "open": "{", "close": "}" }
	],
	"surroundingPairs": [
		{ "open": "\"", "close": "\"" },
		{ "open": "'", "close": "'" },
		{ "open": "`", "close": "`" },
		{ "open": "(", "close": ")" },
		{ "open": "[", "close": "]" },
		{ "open": "{", "close": "}" }
	]
}
