{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "DRIP Note",
  "scopeName": "source.dripnote",
  "patterns": [
    { "include": "#comments" },
    { "include": "#headings" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "match": "^[\\t ]*//.*$",
          "name": "comment.line.double-slash.dripnote"
        }
      ]
    },
    "headings": {
      "patterns": [
        {
          "match": "^([\\t ]*#{1,6})(\\s+)",
          "captures": {
            "1": { "name": "punctuation.definition.heading.dripnote" }
          }
        }
      ]
    }
  }
}
