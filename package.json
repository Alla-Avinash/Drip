{
	"name": "drip",
	"displayName": "DRIP",
	"description": "Prototype DRIP note ingestion UI",
	"version": "0.0.1",
	"publisher": "alla-avinash",
	"license": "MIT",
	"engines": {
		"vscode": "^1.85.0"
	},
	"main": "./extension.js",
	"activationEvents": [
		"onStartupFinished",
		"onLanguage:dripnote",
		"onCommand:drip.openComposer",
		"onCommand:drip.openKbEditor",
		"onCommand:drip.openTagsPanel",
		"onCommand:drip.openRetriever",
		"onCommand:drip.retrieverQuickOpen",
		"onCommand:drip.openProjectView",
		"onWebviewPanel:drip.tagsGraph",
		"onWebviewPanel:drip.retriever",
		"onCommand:drip.captureSelectionToComposer",
		"onCommand:drip.selectKnowledgeBase",
		"onCommand:drip.openDripSettingsView",
		"onCommand:drip.github.pushBackup",
		"onCommand:drip.github.pullBackup",
		"onCommand:drip.github.initRepo",
		"onView:drip.components",
		"onView:drip.knowledgeBase",
		"onView:drip.drafts",
		"onView:drip.recents",
		"onView:drip.dailyNotes",
		"onView:drip.storage",
		"onView:drip.headingForm",
		"onView:drip.chat",
		"onCommand:drip.focusChat",
		"onCommand:drip.addSelectionToChat",
		"onCommand:drip.copyPath",
		"onCommand:drip.renameItem",
		"onCommand:drip.createFolder",
		"onCommand:drip.deleteItem",
		"onCommand:drip.testEmbeddings",
		"onCustomEditor:drip.mdEditor"
	],
	"capabilities": {
		"virtualWorkspaces": true,
		"untrustedWorkspaces": {
			"supported": true
		}
	},
	"contributes": {
		"customEditors": [
			{
				"viewType": "drip.mdEditor",
				"displayName": "DRIP Markdown",
				"selector": [
					{
						"filenamePattern": "*.d.md"
					}
				],
				"priority": "default"
			}
		],
		"viewsContainers": {
			"activitybar": [
				{
					"id": "drip",
					"title": "DRIP",
					"icon": "$(notebook)"
				}
			],
			"secondarySidebar": [
				{
					"id": "drip-storage-panel",
					"title": "DRIP",
					"icon": "$(notebook)"
				}
			]
		},
		"views": {
			"drip": [
				{
					"id": "drip.components",
					"name": "Components",
					"icon": "$(extensions)",
					"visibility": "visible",
					"initialSize": 5
				},
				{
					"id": "drip.knowledgeBase",
					"name": "Knowledge Base",
					"icon": "$(folder)",
					"visibility": "visible"
				},
				{
					"id": "drip.dailyNotes",
					"name": "Daily Notes",
					"icon": "$(calendar)",
					"visibility": "visible",
					"initialSize": 5
				},
				{
					"id": "drip.drafts",
					"name": "Drafts",
					"icon": "$(note)",
					"visibility": "visible",
					"initialSize": 4
				},
				{
					"id": "drip.recents",
					"name": "Recents",
					"icon": "$(history)",
					"visibility": "visible",
					"initialSize": 4
				}
			],
			"drip-storage-panel": [
				{
					"id": "drip.headingForm",
					"name": "Heading",
					"type": "webview",
					"icon": "$(edit)",
					"when": "!drip.rhsHideHeading"
				},
				{
					"id": "drip.storage",
					"name": "Storage",
					"type": "webview",
					"icon": "$(folder)",
					"when": "!drip.rhsHideStorage"
				},
				{
					"id": "drip.chat",
					"name": "Chat",
					"type": "webview",
					"icon": "$(comment)"
				}
			]
		},
		"commands": [
			{
				"command": "drip.openComposer",
				"title": "Open Composer"
			},
			{
				"command": "drip.openTodayDailyNote",
				"title": "New Daily Note",
				"category": "DRIP",
				"icon": "$(add)"
			},
			{
				"command": "drip.openRecentFile",
				"title": "Open Recent File",
				"category": "DRIP"
			},
			{
				"command": "drip.openKbEditor",
				"title": "Open KB Editor",
				"category": "DRIP",
				"icon": "$(notebook)"
			},
			{
				"command": "drip.openTagsPanel",
				"title": "Open Tags Graph",
				"category": "DRIP",
				"icon": "$(graph)"
			},
			{
				"command": "drip.openRetriever",
				"title": "Open Retriever",
				"category": "DRIP",
				"icon": "$(search)"
			},
			{
				"command": "drip.retrieverQuickOpen",
				"title": "Quick Open Heading…",
				"category": "DRIP",
				"icon": "$(list-selection)"
			},
			{
				"command": "drip.openProjectView",
				"title": "Open Project View",
				"category": "DRIP",
				"icon": "$(folder-library)"
			},
			{
				"command": "drip.captureSelectionToComposer",
				"title": "Capture Selection to Composer"
			},
			{
				"command": "drip.openDripSettingsView",
				"title": "Open DRIP Settings",
				"category": "DRIP",
				"icon": "$(gear)"
			},
			{
				"command": "drip.github.configureRemote",
				"title": "Configure GitHub backup remote",
				"category": "DRIP"
			},
			{
				"command": "drip.github.initRepo",
				"title": "Initialize GitHub backup",
				"category": "DRIP"
			},
			{
				"command": "drip.github.pushBackup",
				"title": "Push knowledge base backup",
				"category": "DRIP"
			},
			{
				"command": "drip.github.pullBackup",
				"title": "Pull knowledge base backup",
				"category": "DRIP"
			},
			{
				"command": "drip.github.openRemote",
				"title": "Open GitHub backup remote",
				"category": "DRIP"
			},
			{
				"command": "drip.github.setPat",
				"title": "Set GitHub backup token",
				"category": "DRIP"
			},
			{
				"command": "drip.github.clearPat",
				"title": "Clear GitHub backup token",
				"category": "DRIP"
			},
			{
				"command": "drip.mcp.openSettings",
				"title": "Open MCP connection settings",
				"category": "DRIP"
			},
			{
				"command": "drip.mcp.restart",
				"title": "Restart MCP server",
				"category": "DRIP"
			},
			{
				"command": "drip.mcp.regenerateToken",
				"title": "Regenerate MCP access token",
				"category": "DRIP"
			},
			{
				"command": "drip.selectKnowledgeBase",
				"title": "Select Knowledge Base Folder",
				"category": "DRIP",
				"icon": "$(folder-opened)"
			},
			{
				"command": "drip.createNoteFile",
				"title": "New Note",
				"category": "DRIP",
				"icon": "$(notebook)"
			},
			{
				"command": "drip.createMarkdownFile",
				"title": "New File",
				"category": "DRIP",
				"icon": "$(file-add)"
			},
			{
				"command": "drip.createFolder",
				"title": "New Folder",
				"category": "DRIP",
				"icon": "$(new-folder)"
			},
			{
				"command": "drip.createProjectFolder",
				"title": "New Project",
				"category": "DRIP",
				"icon": "$(folder-library)"
			},
			{
				"command": "drip.createFeatureFolder",
				"title": "New Feature Folder",
				"category": "DRIP",
				"icon": "$(folder)"
			},
			{
				"command": "drip.createFeatureFile",
				"title": "New Feature File",
				"category": "DRIP",
				"icon": "$(file)"
			},
			{
				"command": "drip.createDripIgnore",
				"title": "New .dripignore File"
			},
			{
				"command": "drip.showKbNewMenu",
				"title": "New",
				"category": "DRIP",
				"icon": "$(add)"
			},
			{
				"command": "drip.ignorePath",
				"title": "add to .dripignore"
			},
			{
				"command": "drip.refreshTree",
				"title": "Refresh",
				"category": "DRIP",
				"icon": "$(refresh)"
			},
			{
				"command": "drip.copyPath",
				"title": "Copy Path"
			},
			{
				"command": "drip.renameItem",
				"title": "Rename"
			},
			{
				"command": "drip.convertFolderToFeature",
				"title": "Convert to Feature Folder",
				"category": "DRIP"
			},
			{
				"command": "drip.deleteProject",
				"title": "Delete Project",
				"category": "DRIP",
				"icon": "$(trash)"
			},
			{
				"command": "drip.deleteFeature",
				"title": "Delete Feature",
				"category": "DRIP",
				"icon": "$(trash)"
			},
			{
				"command": "drip.deleteItem",
				"title": "Delete",
				"icon": "$(trash)"
			},
			{
				"command": "drip.testEmbeddings",
				"title": "DRIP: Run Embedding Benchmark"
			},
			{
				"command": "drip.focusChat",
				"title": "Open DRIP Chat",
				"category": "DRIP",
				"icon": "$(comment)"
			},
			{
				"command": "drip.addSelectionToChat",
				"title": "Add Selection to DRIP Chat",
				"category": "DRIP",
				"icon": "$(comment-discussion)"
			},
			{
				"command": "drip.rebuildKbIndexNow",
				"title": "DRIP: Update index",
				"category": "DRIP",
				"icon": "$(sync)"
			},
			{
				"command": "drip.reindexCurrentKbWorkspace",
				"title": "Update/reindex the current KB working space",
				"category": "DRIP",
				"icon": "$(sync)"
			},
			{
				"command": "drip.resetReindexEntireKb",
				"title": "Reset/reindex the entire KB driplock folder",
				"category": "DRIP",
				"icon": "$(debug-restart)"
			},
			{
				"command": "drip.updateIndexScope",
				"title": "DRIP: Update",
				"category": "DRIP",
				"icon": "$(sync)"
			},
			{
				"command": "drip.processPendingLinkMigrations",
				"title": "DRIP: Process pending link migrations",
				"category": "DRIP",
				"icon": "$(link-external)"
			},
			{
				"command": "drip.copyHeadingIdentity",
				"title": "DRIP: Copy heading identity",
				"category": "DRIP"
			},
			{
				"command": "drip.createIndexHere",
				"title": "Rebuild index.drip",
				"category": "DRIP",
				"icon": "$(folder-add)"
			},
			{
				"command": "drip.removeIndexHere",
				"title": "Remove _index Here (deprecated)",
				"category": "DRIP",
				"icon": "$(trash)"
			}
		],
		"configurationDefaults": {
			"[dripnote]": {
				"editor.insertSpaces": false,
				"editor.tabSize": 4,
				"editor.detectIndentation": false,
				"editor.stickyScroll.defaultModel": "indentationModel",
				"editor.quickSuggestions": {
					"other": true,
					"comments": false,
					"strings": true
				}
			},
			"workbench.editorAssociations": {
				"*.d.md": "drip.mdEditor"
			}
		},
		"configuration": {
			"title": "DRIP",
			"properties": {
				"drip.autoOpenComposerOnSidebarReveal": {
					"type": "boolean",
					"default": true,
					"description": "Open the Note Composer the first time the Knowledge Base sidebar becomes visible in this window."
				},
				"drip.knowledgeBaseFileExtensions": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [
						".d.txt",
						".md"
					],
					"description": "File extensions (with a leading dot) treated as knowledge base notes in the tree, scans, and storage suggestions. Example: [\".d.txt\", \".md\"] includes README.md when \".md\" is listed."
				},
				"drip.defaultNewNoteExtension": {
					"type": "string",
					"default": ".d.txt",
					"description": "Extension for newly created notes from the KB and Storage flows. Must be one of the values in drip.knowledgeBaseFileExtensions."
				},
				"drip.editHeadingsInFile": {
					"type": "boolean",
					"default": false,
					"description": "Edit persistent headings (# .…) directly in the .d.txt file. Mutually exclusive with drip.editHeadingsViaRhs (Settings → Editor radios)."
				},
				"drip.editHeadingsViaRhs": {
					"type": "boolean",
					"default": true,
					"description": "Edit persistent headings via the RHS Heading form (recommended). Opens after a space following . / type shortcut; soft-locks title/metadata in the editor."
				},
				"drip.mcp.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Run the DRIP MCP server on 127.0.0.1 so any MCP-capable AI app can manage project issues. Connection details: DRIP Settings → MCP connection."
				},
				"drip.mcp.port": {
					"type": "number",
					"default": 39217,
					"description": "Local port for the DRIP MCP server (http://127.0.0.1:<port>/mcp). Only one DRIP window can serve a port."
				},
				"drip.llm.enabled": {
					"type": "boolean",
					"default": false,
					"description": "Enable the lightweight LLM used by DRIP Quick Capture to decide where a note belongs (merge / append / new heading). The API key is stored securely in VS Code Secret Storage, not in settings."
				},
				"drip.llm.baseUrl": {
					"type": "string",
					"default": "https://api.openai.com/v1",
					"description": "OpenAI-compatible chat completions base URL for DRIP's lightweight LLM. Examples: https://api.openai.com/v1, https://api.groq.com/openai/v1, or a local http://localhost:11434/v1 (Ollama)."
				},
				"drip.llm.model": {
					"type": "string",
					"default": "gpt-4o-mini",
					"description": "Model id for DRIP's lightweight LLM. Examples: gpt-4o-mini, claude-3-haiku, llama-3.1-8b-instant, or a local model name."
				},
				"drip.dripnoteAllowedMetadataKeys": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Additional allowed metadata keys for DRIP .d.txt metadata blocks (beyond built-ins like status, deadline, tags, pre-req). Unknown keys are underlined as errors unless listed here."
				},
				"drip.dripnoteCustomTypeMarkers": {
					"type": "array",
					"items": {
						"type": "string"
					},
					"default": [],
					"description": "Custom .d.txt type markers (without leading dot), e.g. [\"idea\", \"note\"]."
				},
				"drip.dripnoteCustomColors": {
					"type": "object",
					"default": {},
					"description": "Optional custom colors for .d.txt markdown tokens. Map token to color (e.g. { \".idea\": \"#ffcc00\", \"tags\": \"#66ccff\" })."
				},
				"drip.dripnoteDocColors": {
					"type": "object",
					"default": {},
					"description": "Optional overrides for the six DRIP document colors. Keys: color1 (type/shortcut), color2 (heading), color3 (metadata key), color4 (tag/relation key), color5 (values + separators), color6 (file identity key). Each value is a hex color; empty means follow the theme palette.",
					"properties": {
						"color1": {
							"type": "string"
						},
						"color2": {
							"type": "string"
						},
						"color3": {
							"type": "string"
						},
						"color4": {
							"type": "string"
						},
						"color5": {
							"type": "string"
						},
						"color6": {
							"type": "string"
						}
					}
				},
				"drip.metadataTemplatesEnabled": {
					"type": "boolean",
					"default": true,
					"description": "Enable metadata templates and type-specific key/value rules for DRIP .d.txt files."
				},
				"drip.metadataStrictValidation": {
					"type": "boolean",
					"default": true,
					"description": "Validate metadata values against configured template rules and show diagnostics with quick fixes."
				},
				"drip.metadataIgnoreErrors": {
					"type": "boolean",
					"default": false,
					"description": "Suppress metadata template diagnostics while still keeping template-driven completion behavior."
				},
				"drip.metadataAutoInsertTemplate": {
					"type": "boolean",
					"default": true,
					"description": "When a metadata type marker is entered in a valid metadata zone, insert missing template keys automatically."
				},
				"drip.metadataShowIndentErrors": {
					"type": "boolean",
					"default": true,
					"description": "Show indentation diagnostics for heading metadata blocks (marker/key nesting and heading-adjacent metadata layout)."
				},
				"drip.showHeadingHierarchyIndentErrors": {
					"type": "boolean",
					"default": true,
					"description": "Show errors when # headings break tab-based hierarchy (e.g. nested heading after column-0 body text without a root #)."
				},
				"drip.metadataUseCustomColors": {
					"type": "boolean",
					"default": false,
					"description": "Use custom metadata colors from DRIP settings instead of theme defaults."
				},
				"drip.metadataTypes": {
					"type": "array",
					"default": [
						{
							"id": "concept",
							"marker": ".concept",
							"shortcut": "c",
							"color": "",
							"displayTemplate": true,
							"attributes": {
								"domain": {
									"kind": "enum",
									"default": "",
									"required": false,
									"values": []
								},
								"status": {
									"kind": "enum",
									"default": "",
									"required": false,
									"values": [
										"in-progress",
										"to-do"
									]
								}
							}
						},
						{
							"id": "task",
							"marker": ".task",
							"shortcut": "t",
							"color": "",
							"displayTemplate": true,
							"attributes": {
								"status": {
									"kind": "enum",
									"default": "",
									"required": true,
									"values": [
										"in-progress",
										"to-do",
										"completed"
									]
								},
								"priority": {
									"kind": "enum",
									"default": "",
									"required": true,
									"values": [
										"high",
										"low"
									]
								},
								"deadline": {
									"kind": "datetime",
									"default": "",
									"required": true
								},
								"category": {
									"kind": "enum",
									"default": "",
									"required": false,
									"values": []
								}
							}
						},
						{
							"id": "issue",
							"marker": ".issue",
							"shortcut": "i",
							"color": "",
							"displayTemplate": true,
							"attributes": {
								"priority": {
									"kind": "enum",
									"default": "",
									"required": false,
									"values": [
										"high",
										"medium",
										"low"
									]
								},
								"status": {
									"kind": "enum",
									"default": "",
									"required": true,
									"values": [
										"in-progress",
										"to-do",
										"completed"
									]
								},
								"deadline": {
									"kind": "datetime",
									"default": "",
									"required": false
								},
								"category": {
									"kind": "enum",
									"default": "",
									"required": false,
									"values": []
								},
								"parent": {
									"kind": "ref",
									"default": "",
									"required": false
								},
								"decision": {
									"kind": "ref",
									"default": "",
									"required": false
								},
								"concept": {
									"kind": "ref",
									"default": "",
									"required": false
								}
							}
						},
						{
							"id": "decision",
							"marker": ".decision",
							"shortcut": "d",
							"color": "",
							"displayTemplate": true,
							"attributes": {
								"status": {
									"kind": "enum",
									"default": "",
									"required": false,
									"values": [
										"in-progress",
										"to-do",
										"completed"
									]
								},
								"category": {
									"kind": "enum",
									"default": "",
									"required": false,
									"values": [
										"architecture",
										"techstack",
										"design",
										"ux"
									]
								},
								"superseded-by": {
									"kind": "ref",
									"default": "",
									"required": false
								},
								"concept": {
									"kind": "ref",
									"default": "",
									"required": false
								}
							}
						}
					],
					"description": "Document (heading) metadata type definitions for .d.txt notes. Project and feature are configured under drip.fileLevelMetadataTypes (special metadata types)."
				},
				"drip.fileLevelMetadataTypes": {
					"type": "array",
					"default": [
						{
							"id": "project",
							"marker": ".project",
							"shortcut": "p",
							"color": "",
							"displayTemplate": true,
							"attributes": {
								"status": {
									"kind": "enum",
									"default": "",
									"required": true,
									"values": [
										"in-progress",
										"to-do",
										"completed"
									]
								},
								"priority": {
									"kind": "enum",
									"default": "",
									"required": false,
									"values": [
										"high",
										"medium",
										"low"
									]
								},
								"deadline": {
									"kind": "datetime",
									"default": "",
									"required": false
								}
							}
						},
						{
							"id": "feature",
							"marker": ".feature",
							"shortcut": "f",
							"color": "",
							"displayTemplate": true,
							"attributes": {
								"category": {
									"kind": "enum",
									"default": "",
									"required": false,
									"values": []
								}
							}
						}
					],
					"description": "Special metadata types for project (.p) and feature (.f) folder index notes. Shortcuts are .p / .f; RHS Heading shows only this type on those files."
				},
				"drip.metadataTypeColors": {
					"type": "object",
					"default": {
						"new-type": "#4ec9b0"
					},
					"description": "Optional metadata type colors keyed by metadata type id."
				},
				"drip.tagsRelationsConfig": {
