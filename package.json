		"semanticTokenTypes": [
			{
				"id": "metatype",
				"superType": "type",
				"description": "DRIP metadata type name/shortcut (e.g. .concept, .c)."
			},
			{
				"id": "heading",
				"superType": "string",
				"description": "DRIP heading line text (rendered bold)."
			},
			{
				"id": "metakey",
				"superType": "keyword",
				"description": "DRIP metadata key (e.g. status, deadline)."
			},
			{
				"id": "relationkey",
				"superType": "property",
				"description": "DRIP tag/relation key (e.g. tags, pre-req)."
			},
			{
				"id": "metavalue",
				"superType": "string",
				"description": "DRIP heading-special value or section separator."
			},
			{
				"id": "fileidentity",
				"superType": "label",
				"description": "DRIP file-level identity field (filename, fileid, headings)."
			},
			{
				"id": "identityvalue",
				"superType": "string",
				"description": "DRIP file identity value (filename/fileid/headings value)."
			},
			{
				"id": "typedvalue",
				"superType": "string",
				"description": "DRIP metadata type field value (status/deadline value)."
			},
			{
				"id": "relationvalue",
				"superType": "string",
				"description": "DRIP tag/relation list value."
			}
		],
